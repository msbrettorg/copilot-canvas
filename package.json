{
  "name": "copilot-canvas-apps",
  "version": "1.0.0",
  "private": true,
  "description": "Source and publish tools for local GitHub Copilot canvas apps",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:app": "node scripts/build.mjs",
    "publish": "node scripts/publish.mjs",
    "publish:all": "node scripts/publish.mjs --all",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
